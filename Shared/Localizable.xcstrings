    "Choose a note to read or edit the transcript, see the summary, or ask a question.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en note for at læse eller redigere transskriptionen, se resuméet eller stille et spørgsmål."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een notitie om de transcriptie te lezen of te bewerken, de samenvatting te bekijken of een vraag te stellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une note pour lire ou modifier sa transcription, consulter son résumé ou poser une question."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Notiz, um das Transkript zu lesen oder zu bearbeiten, die Zusammenfassung zu sehen oder eine Frage zu stellen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una nota per leggere o modificare la trascrizione, vedere il riepilogo o fare una domanda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg et notat for å lese eller redigere transkripsjonen, se sammendraget eller stille et spørsmål."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma nota para ler ou editar a transcrição, ver o resumo ou fazer uma pergunta."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una nota para leer o editar la transcripción, ver el resumen o hacer una pregunta."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en anteckning för att läsa eller redigera transkriptionen, se sammanfattningen eller ställa en fråga."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dökümü okumak veya düzenlemek, özeti görmek ya da soru sormak için bir not seç."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ghi chú để đọc hoặc sửa bản chép lời, xem bản tóm tắt hoặc đặt câu hỏi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择笔记，阅读或编辑转录文本、查看摘要，或提出问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇筆記，以閱讀或編輯逐字稿、查看摘要或提出問題。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートを選ぶと、文字起こしの閲覧や編集、要約の確認、質問ができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트를 선택해 전사문을 읽거나 편집하고, 요약을 보거나 질문하세요."
          }
        }
      }
    },
    "Capture a thought, meeting, or lecture. Edit the transcript and get the key points with Apple Intelligence, right on your device.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optag en tanke, et møde eller en forelæsning. Rediger transskriptionen, og få hovedpunkterne med Apple Intelligence direkte på din enhed."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leg een gedachte, vergadering of college vast. Bewerk de transcriptie en haal de hoofdpunten eruit met Apple Intelligence op je eigen apparaat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez une idée, une réunion ou un cours. Modifiez la transcription et retrouvez les points clés avec Apple Intelligence, directement sur votre appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte einen Gedanken, eine Besprechung oder eine Vorlesung fest. Bearbeite das Transkript und erfasse die wichtigsten Punkte mit Apple Intelligence direkt auf deinem Gerät."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un pensiero, una riunione o una lezione. Modifica la trascrizione e trova i punti chiave con Apple Intelligence, direttamente sul dispositivo."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta opp en tanke, et møte eller en forelesning. Rediger transkripsjonen og få hovedpunktene med Apple Intelligence, direkte på enheten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave uma ideia, reunião ou aula. Edite a transcrição e veja os pontos principais com a Apple Intelligence no seu dispositivo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba una idea, una reunión o una clase. Edita la transcripción y obtén los puntos clave con Apple Intelligence en tu dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela in en tanke, ett möte eller en föreläsning. Redigera transkriptionen och få huvudpunkterna med Apple Intelligence direkt på enheten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir düşünceyi, toplantıyı veya dersi kaydet. Dökümü düzenle ve Apple Intelligence ile önemli noktaları doğrudan cihazında çıkar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi lại một ý tưởng, cuộc họp hoặc bài giảng. Chỉnh sửa bản chép lời và tìm các ý chính với Apple Intelligence ngay trên thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录想法、会议或讲座。使用设备上的 Apple Intelligence 编辑转录文本并提取要点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄想法、會議或講座。使用裝置上的 Apple Intelligence 編輯逐字稿並擷取重點。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "思いついたことや会議、講義を録音。デバイス上の Apple Intelligence で文字起こしを編集し、要点を確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생각, 회의, 강의를 녹음하세요. 기기에서 Apple Intelligence로 전사문을 편집하고 핵심 내용을 확인하세요."
          }
        }
      }
    }
  },
  "version": "1.0"
}
