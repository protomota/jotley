    "Speech uses a separate Apple model. Setup needs internet access; transcription then works offline.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tale bruger en separat Apple-model. Opsætning kræver internet, og derefter virker transskription offline."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spraak gebruikt een apart Apple-model. Na de online installatie kun je offline transcriberen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription utilise un modèle Apple distinct. Une connexion est requise pour l’installation, puis la transcription fonctionne hors ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spracherkennung nutzt ein eigenes Apple-Modell. Nach der Online-Einrichtung funktioniert die Transkription offline."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione usa un modello Apple separato. Dopo la configurazione online, funziona anche offline."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Tale bruker en egen Apple-modell. Oppsett krever internett. Deretter kan du transkribere frakoblet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição usa um modelo separado da Apple. Após a configuração pela internet, ela funciona offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción usa un modelo de Apple independiente. Una vez configurado por internet, funciona sin conexión."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tal använder en separat Apple-modell. Efter installationen via internet fungerar transkriberingen offline."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Döküm için ayrı bir Apple modeli kullanılır. İnternet üzerinden kurduktan sonra çevrimdışı çalışır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính năng chép lời dùng mô hình riêng của Apple. Thiết lập cần mạng, sau đó có thể chép lời ngoại tuyến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音转录使用单独的 Apple 模型。联网设置后即可离线转录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音轉錄使用獨立的 Apple 模型。連線設定後即可離線轉錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしには Apple の別のモデルを使用します。オンラインで設定すると、オフラインで使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기는 별도의 Apple 모델을 사용합니다. 인터넷으로 설정한 뒤에는 오프라인으로 작동합니다."
          }
        }
      }
    },
