    "Download Apple’s speech model once to transcribe offline.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hent Apples talemodel én gang for at transskribere offline."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download één keer het spraakmodel van Apple om offline te transcriberen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez une fois le modèle vocal Apple pour transcrire hors ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade Apples Sprachmodell einmal herunter, um offline zu transkribieren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica una sola volta il modello vocale Apple per trascrivere offline."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Last ned Apples talemodell én gang for å transkribere frakoblet."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe o modelo de fala da Apple uma vez para transcrever offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga una vez el modelo de voz de Apple para transcribir sin conexión."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämta Apples talmodell en gång för att kunna transkribera offline."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışı döküm için Apple’ın konuşma modelini bir kez indir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải mô hình giọng nói của Apple một lần để chép lời ngoại tuyến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载一次 Apple 语音模型，即可离线转录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載一次 Apple 的語音模型，即可離線轉錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple の音声モデルを一度ダウンロードすると、オフラインで文字起こしできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 음성 모델을 한 번 내려받으면 오프라인으로 받아쓸 수 있습니다."
          }
        }
      }
    },
