    "Change your language or finish setup later in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skift sprog eller afslut opsætningen senere i Indstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzig de taal of voltooi de configuratie later in Instellingen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez changer de langue ou terminer la configuration dans Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere die Sprache oder beende die Einrichtung später in den Einstellungen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia lingua o completa la configurazione in Impostazioni."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytt språk eller fullfør oppsettet senere i Innstillinger."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altere o idioma ou conclua a configuração depois em Ajustes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia de idioma o termina la configuración más tarde en Ajustes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byt språk eller slutför inställningen senare i Inställningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dili değiştir veya kurulumu daha sonra Ayarlar’dan tamamla."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổi ngôn ngữ hoặc hoàn tất thiết lập sau trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以稍后在“设置”中更改语言或完成设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以稍後在「設定」更改語言或完成設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語の変更や設定の完了は、後で「設定」から行えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에 설정에서 언어를 바꾸거나 설정을 마칠 수 있습니다."
          }
        }
      }
    },
