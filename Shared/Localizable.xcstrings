    "Choose your Apple Intelligence language.\nTranscription, summaries and Ask AI stay on-device.": {
      "extractionState": "manual",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg dit sprog til Apple Intelligence.\nTransskription, resuméer og Spørg AI bliver på enheden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies je taal voor Apple Intelligence.\nTranscripties, samenvattingen en Vraag AI blijven op dit apparaat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez votre langue pour Apple Intelligence.\nLa transcription, les résumés et les réponses de l’IA restent sur l’appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle deine Sprache für Apple Intelligence.\nTranskripte, Zusammenfassungen und KI-Antworten bleiben auf deinem Gerät."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la lingua di Apple Intelligence.\nTrascrizioni, riepiloghi e risposte dell’IA restano sul dispositivo."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg språk for Apple Intelligence.\nTranskripsjon, sammendrag og KI-svar blir på enheten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha seu idioma para o Apple Intelligence.\nTranscrições, resumos e respostas da IA ficam no dispositivo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tu idioma para Apple Intelligence.\nLas transcripciones, los resúmenes y las respuestas de la IA se quedan en tu dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj språk för Apple Intelligence.\nTranskribering, sammanfattningar och AI-svar stannar på enheten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence dilini seç.\nDökümler, özetler ve yapay zekâ yanıtları cihazında kalır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ngôn ngữ cho Apple Intelligence.\nBản chép lời, tóm tắt và câu trả lời AI đều ở trên thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 Apple 智能的语言。\n转录、摘要和 AI 回答均在设备端处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇 Apple Intelligence 的語言。\n轉錄、摘要和 AI 回答都在裝置上處理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence の言語を選択してください。\n文字起こし、要約、AI の回答はデバイス上で処理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence에 사용할 언어를 선택하세요.\n받아쓰기, 요약, AI 답변은 기기에서 처리됩니다."
          }
        }
      }
    },
